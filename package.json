{
  "name": "node-micro-boilerplate",
  "version": "1.0.0",
  "description": "Minimal starter files to create a Node.js app.",
  "type": "module",
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "main": "./src/index.mjs",
  "scripts": {
    "start": "node ./src/index.mjs",
    "start:dev": "node --watch --env-file=.env ./src/index.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HenriqueSilverio/node-micro-boilerplate.git"
  },
  "author": "Henrique Silvério",
  "license": "GPL-3.0",
  "dependencies": {
    "require-env": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/jest": "30.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-jest": "29.15.4",
    "globals": "17.7.0",
    "jest": "30.5.2"
  }
}
